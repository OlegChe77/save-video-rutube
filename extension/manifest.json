{
  "manifest_version": 2,
  "name": "Сохрани видео для Rutube",
  "version": "1.0.0",
  "description": "Скачивание видео с Rutube со звуком, отрывков, кадров и обложек. Работает без сторонних программ.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rtdl-5a539900@firefox-addon",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": [
    "downloads",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "*://rutube.ru/*",
    "*://*.rutube.ru/*",
    "*://*.rtbcdn.ru/*"
  ],
  "background": { "scripts": ["lib/mp4.js", "lib/ts.js", "lib/rutube.js", "background.js"] },
  "browser_action": {
    "default_title": "Сохрани видео для Rutube",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://rutube.ru/*"],
      "js": ["common.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
